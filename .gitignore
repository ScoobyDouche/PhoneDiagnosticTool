# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard
proguard/

# Log Files
*.log

# Android Studio / IntelliJ
.navigation/
captures/
*.iml
.idea/

# Binary keystores (never commit release keys)
*.jks
*.keystore
!keystore/.gitkeep

# Decoded CI debug keystore (repo keeps only .b64)
keystore/debug.keystore

# Base64-encoded keystores. This is the form a key takes on its way to a
# GitHub secret, and committing one is exactly how this project ended up
# shipping under a public key. The debug one below is deliberate and already
# tracked; nothing else in this shape may be added.
*.b64
!keystore/debug.keystore.b64

# Google Services / Firebase
google-services.json

# External native build
.externalNativeBuild
.cxx/

# Kotlin
.kotlin/

# Profiling
*.hprof
