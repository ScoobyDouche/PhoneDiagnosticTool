    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_summary">On-device hardware and system diagnostics for Android. No accounts. No analytics SDKs.</string>
    <string name="about_privacy_heading">Privacy</string>
    <string name="about_privacy_body">Diagnostics run on your device. The optional network latency check opens a short TCP connection to 8.8.8.8:53 and does not upload reports. You can turn it off in Settings. Full policy: PRIVACY.md in the repository.</string>
    <string name="about_license_heading">License</string>
    <string name="about_license_body">MIT License. See LICENSE in the project repository.</string>
    <string name="about_source_heading">Source</string>
    <string name="about_source_url">github.com/ScoobyDouche/PhoneDiagnosticTool</string>
    <!--
      The display string above is deliberately scheme-less because it reads
      better on screen, so it cannot be handed to ACTION_VIEW as-is: Uri.parse
      on a scheme-less string yields a relative URI that resolves to nothing.
      This is the one that gets opened.
    -->
    <string name="about_source_link" translatable="false">https://github.com/ScoobyDouche/PhoneDiagnosticTool</string>
    <!-- Announced by screen readers as "double tap to <this>". -->
    <string name="about_source_action">open the source repository in a browser</string>

