    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_summary">On-device hardware and system diagnostics for Android. No accounts. No analytics SDKs.</string>
    <string name="about_privacy_heading">Privacy</string>
    <string name="about_privacy_body">Diagnostics run on your device. The optional network latency check opens a short TCP connection to 8.8.8.8:53 and does not upload reports. You can turn it off in Settings. Full policy: PRIVACY.md in the repository.</string>
    <string name="about_license_heading">License</string>
