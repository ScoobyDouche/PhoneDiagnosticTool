<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml: opt out of both transports. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
